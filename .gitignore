# Ignore everything
*

# Allow directories (so git can traverse them)
!*/

# Allow markdown files
!*.md

# Allow README image assets.
!docs/images/*.jpg

# Allow shell scripts
!*.sh

# Allow python scripts
!*.py

# Allow HTML files
!*.html

# Allow bundled audio cues.
!audio/*.mp3

# Allow .env.example for onboarding new devs
!.env.example

# Allow public license and GitHub issue forms.
!LICENSE
!.github/ISSUE_TEMPLATE/*.yml

# Ignore repo-local pytest/temp runtime data used to keep test state away from
# live external_data persistence roots, but keep the directory anchor checked in.
.test/*
!.test/.gitkeep

# Ignore Python packaging and runtime output.
/build/
/*.egg-info/
__pycache__/
.pytest_cache/

# Ignore example workspace directories created by setup.
*-workspace/

# Allow workstreams data (source of truth for task/board state)
!workstreams/**

# Keep per-workstream secrets out of git
workstreams/**/.env
workstreams/**/.env.*
!workstreams/**/.env.example

# Allow artifacts data
!artifacts/**

# Ignore runtime and generated logs under artifacts.
artifacts/logs/

# Allow YAML files (used by workstreams)
!*.yaml

# Allow Python project and dependency metadata.
!pyproject.toml

# Ignore root-level runtime state.
/workspace_audit.yaml
/scheduler_state.yaml

# Allow this file itself
!.gitignore

# Allow GitHub CI workflow files
!.github/workflows/*.yml

# Allow the Prova product directory (all product source code)
!prova/**

# But exclude build artifacts and dependencies within prova
prova/frontend/node_modules/
prova/frontend/.nuxt/
prova/frontend/.output/
prova/backend/.venv/
prova/backend/__pycache__/
prova/backend/**/__pycache__/
prova/backend/*.egg-info/
prova/.env