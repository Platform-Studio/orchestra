# Copy this file to .env and set only the values you need.
# Never commit a populated .env file.

# Keep runtime state and artifacts outside the Orchestra code repository.
WORKSTREAM_ROOT=~/orchestra_data
ARTIFACT_ROOT=~/orchestra_data

# Runtime: GitHub Copilot CLI
ORCHESTRATION_AGENT_RUNTIME=copilot
COPILOT_MODEL=gpt-5.6-sol
COPILOT_CODING_LLM=gpt-5.6-sol
# Use Copilot's automatic model selection instead of a fixed default:
# COPILOT_MODEL=auto

# Local Ollama provider for agents with x-provider: ollama.
OLLAMA_LOCAL_URL=http://127.0.0.1:11434/v1
OLLAMA_DEFAULT_MODEL=gemma4:latest

# Optional model overrides for agents using x-model-level.
# COPILOT_HIGH_LLM=gpt-5.6-sol
# COPILOT_MEDIUM_LLM=gpt-5.6-sol
# COPILOT_LOW_LLM=gpt-5.6-sol

# Copilot normally uses the current user's existing Copilot CLI/GitHub session.
# No token variable is needed for normal local use.
# For non-interactive or CI environments, set one token supported by your
# installed Copilot/GitHub CLI version:
# COPILOT_GITHUB_TOKEN=
# GH_TOKEN=
# GITHUB_TOKEN=

# Alternative runtime: Cline CLI.
# ORCHESTRATION_AGENT_RUNTIME=cline
# ORCHESTRATION_CLINE_CONFIG_DIR=~/.cline
# ORCHESTRATION_CLINE_VERBOSE=true
# CLINE_DEFAULT_LLM=deepseek/deepseek-v4-flash
# CLINE_HIGH_LLM=deepseek/deepseek-v4-pro
# CLINE_MEDIUM_LLM=deepseek/deepseek-v4-flash
# CLINE_LOW_LLM=deepseek/deepseek-v4-flash
# CLINE_CODING_LLM=deepseek/deepseek-v4-flash

# Alternative runtime: Claude Code CLI.
# ORCHESTRATION_AGENT_RUNTIME=claude-code
# ANTHROPIC_API_KEY=

# Optional external definitions. Separate multiple paths with : on macOS/Linux
# or ; on Windows.
# ORCHESTRA_AGENT_PATHS=/path/to/agents
# ORCHESTRA_SKILL_PATHS=/path/to/skills
# ORCHESTRA_CLI_PATHS=/path/to/cli-tools

# Optional effort defaults.
# DEFAULT_EFFORT=medium
# HIGH_EFFORT=high
# MEDIUM_EFFORT=medium
# LOW_EFFORT=low
# CODING_EFFORT=high

# Optional event sounds.
# AUDIO_FILE_PATH can point elsewhere.
# AUDIO_FILE_PATH=/path/to/sounds
DEFAULT_AGENT_START_SOUND=start.mp3
DEFAULT_AGENT_FINISHED_SOUND=finish.mp3
DEFAULT_AGENT_ERROR_SOUND=error.mp3

# Diagnostics.
# WORKSTREAM_MANAGER_LOG_API_REQUESTS=1

# Agent learnings. After a run, Orchestra archives and compacts an agent's
# learnings file when it exceeds this size. Default: 20,000 bytes.
# ORCHESTRATION_LEARNINGS_COMPACTION_THRESHOLD_BYTES=20000

# Route supported Copilot/Cline runs through Beans Proxy for per-task token and
# cost tracking. Set BEANS_PROXY=false if Beans Proxy is not running.
BEANS_PROXY=true
BEANS_PROXY_HOST=127.0.0.1
BEANS_PROXY_PORT=8008

# Bundled image and voice tools.
OPENAI_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
ELEVENLABS_API_KEY=

# Bundled Slack and Mailgun tools.
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
MAILGUN_API_KEY=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=
MAILGUN_DOMAIN=

# Bundled browser tool.
BROWSER_API_TOKEN=
BROWSER_API_URL=
BROWSER_PREFERRED_CLIENT=
