# Copy this file to .env and set only the values you need.
# Never commit a populated .env file.

# Persistence. Defaults are ./workstreams and ./artifacts in this repository.
# WORKSTREAM_ROOT=file:/absolute/path/to/orchestra-state
# ARTIFACT_ROOT=file:/absolute/path/to/orchestra-artifacts

# Agent runtime: claude-code, cline, or copilot.
ORCHESTRATION_AGENT_RUNTIME=copilot
# ORCHESTRATION_CLINE_CONFIG_DIR=~/.cline
# ORCHESTRATION_CLINE_VERBOSE=false

# Optional external definitions. Separate multiple paths with : on macOS/Linux
# or ; on Windows.
# ORCHESTRA_AGENT_PATHS=/path/to/agents
# ORCHESTRA_SKILL_PATHS=/path/to/skills
# ORCHESTRA_CLI_PATHS=/path/to/cli-tools

# Runtime authentication and model selection.
ANTHROPIC_API_KEY=
# COPILOT_GITHUB_TOKEN=
# GH_TOKEN=
# GITHUB_TOKEN=
# COPILOT_MODEL=auto
# COPILOT_HIGH_LLM=auto
# COPILOT_MEDIUM_LLM=auto
# COPILOT_LOW_LLM=auto
# COPILOT_CODING_LLM=auto

# Optional effort defaults.
# DEFAULT_EFFORT=medium
# HIGH_EFFORT=high
# MEDIUM_EFFORT=medium
# LOW_EFFORT=low
# CODING_EFFORT=high

# Optional event sounds and diagnostics.
DEFAULT_AGENT_START_SOUND=
DEFAULT_AGENT_FINISHED_SOUND=
DEFAULT_AGENT_ERROR_SOUND=
WORKSTREAM_MANAGER_LOG_API_REQUESTS=
# ORCHESTRATION_LEARNINGS_COMPACTION_THRESHOLD_BYTES=20000

# Optional Beans Proxy token and cost tracking.
# BEANS_PROXY=true
# BEANS_PROXY_HOST=127.0.0.1
# BEANS_PROXY_PORT=8000

# Bundled image and voice tools.
OPENAI_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
ELEVENLABS_API_KEY=

# Bundled Slack and Mailgun tools.
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
MAILGUN_API_KEY=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=
MAILGUN_DOMAIN=

# Bundled browser tool.
BROWSER_API_TOKEN=
BROWSER_API_URL=
BROWSER_PREFERRED_CLIENT=
